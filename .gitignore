
# Machine-local secrets. The real file lives at ~/.zshrc.local (outside this
# repo); these patterns are a safety net in case a copy ever lands in here.
.zshrc.local
**/.zshrc.local
*.local.zsh

# Claude Code state and credentials. ~/.claude.json holds project history and
# account tokens alongside its config, so it stays out of here; scripts/claude-mcp.sh
# rebuilds the part worth keeping. Same safety-net reasoning as above.
.claude.json
**/.claude.json
.credentials.json
**/.credentials.json
