{
  "permissions": {
    "deny": [
      "Edit(~/dotfiles/**/.claude/settings.json)",
      "Edit(~/dotfiles/**/.claude/settings.local.json)",
      "Edit(~/dotfiles/**/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["~/dotfiles"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/matinechabrier/.claude/hooks/restrict-write-paths.py'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/matinechabrier/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowUnixSockets": ["/Users/matinechabrier/.config/herdr/herdr.sock"]
    },
    "filesystem": {
      "allowWrite": [
        "~/ClaudeAccess",
        "~/dotfiles",
        "~/.config/herdr/herdr.sock"
      ],
      "denyRead": ["~/"],
      "allowRead": ["~/ClaudeAccess", "~/dotfiles", "~/.config/herdr"]
    }
  },
  "theme": "dark"
}
